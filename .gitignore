# Wrangler local cache + state
.wrangler/

# Real wrangler config (account_id + database_id are environment-specific).
# Each deployer copies wrangler.toml.example -> wrangler.toml and fills in
# their own values. The real file is intentionally not committed.
wrangler.toml

# Real registrar key seed. Each deployer copies seed-key.sql.example ->
# seed-key.sql and fills in the SHA-256 of their bootstrap Bearer token.
# Publishing the live hash removes a layer of obscurity (per L3 review item).
seed-key.sql

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment / secrets
.env
.env.*
.dev.vars
.dev.vars.*
secrets.*
*.pem
*.key

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/
*.swp
*.swo

# Build output
dist/
build/

# Misc
*.log
.cache/
